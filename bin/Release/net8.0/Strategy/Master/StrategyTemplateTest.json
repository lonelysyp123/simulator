{
  "schema": "v1.0",
  "profile": {
    "description": "StrategyTemplate"
  },
  "properties": [
    {
      "identifier": "RefrigerationStrategy",
      "input": [
        {
            "identifier": "PCS01.maxTemp",
            "dataType": "System.Double"
        },
        {
          "identifier": "PCS01.avgTemp",
          "dataType": "System.Double"
        },
        {
          "identifier": "PCS01.minTemp",
          "dataType": "System.Double"
        },
        {
          "identifier": "LIQUIDCOOLMAC01.workMode",
          "dataType": "System.UInt16"
        },
        {
          "identifier": "BMS01.overSingleVolDiffAlarmLv3",
          "dataType": "System.Boolean"

        },
        {
          "identifier": "FIREFIGHTING01.detectorNTCFault",
          "dataType": "System.Boolean"

        }
      ],
      "name": "RefrigerationStrategy",
      "description": "温控策略",
      "access": "x",
      "level": 1
    },
    {
      "identifier": "ExceptionActuator",
      "input": [
        {
          "identifier": "*.*Alarm",
          "threshold": [
            true
          ]
        },
        {
          "identifier": "*.*Fault",
          "threshold": [
            true
          ]
        }
      ],
      "name": "ExceptionActuator",
      "description": "故障告警处理策略",
      "access": "x",
      "level": 2
    },
    {
      "identifier": "SmoothPowerActuator",
      "input": [
        {
            "identifier": "PCS01.activePower",
            "threshold": [
                true
            ]
        }
      ],
      "name": "SmoothPowerActuator",
      "description": "功率平滑策略",
      "access": "x",
      "level": 3
    },
    {
      "identifier": "AuxiliaryProtectionActuator",
      "input": [
        {
            "identifier": "BMS01.avgSoc",
            "dataType": "System.Double",
            "threshold": [
                0,
                100
            ]
        },
        {
            "identifier": "PCS01.powerDC",
            "dataType": "System.Double",
            "threshold": [
                -100,
                100
            ]
        },
        {
            "identifier": "PCS01.currDC",
            "dataType": "System.Double",
            "threshold": [
                -100,
                100
            ]
        },
        {
            "identifier": "PCS01.voltDC",
            "dataType": "System.Double",
            "threshold": [
                -100,
                100
            ]
        },
        {
          "identifier": "THERMOHYGROMETER01.temperature",
          "dataType": "System.Double"
        }
      ],
      "name": "AuxiliaryProtectionActuator",
      "description": "电力系统辅助保护策略策略",
      "access": "x",
      "level": 3
    },
    {
      "identifier": "CVActuator",
      "input": [
        {
          "identifier": "PCS01.dCInputVolt"
        }
      ],
      "name": "CVActuator",
      "description": "恒压充放电策略",
      "access": "x",
      "level": 3
    },
    {
      "identifier": "CircuitBreakerActuator1",
      "input": [

        {
          "identifier": "IODEVICE01.stopSwitchFeedBackStatus",
          "threshold": 1
        },
        {
          "identifier": "WATERSENSOR01.waterImmersionStatus1",
          "threshold": 1
        },
        {
          "identifier": "WATERSENSOR01.waterImmersionStatus2",
          "threshold": 2
        },
        {
          "identifier": "05.controllerMaxAlarmLevel",
          "threshold": 3
        }
      ],
      "name": "CircuitBreakerActuator",
      "description": "脱扣器动作策略",
      "access": "x",
      "level": 3
    }
  ],
  "output": [
    {
      "identifier": "PCS",
      "ref": "PCS01"
    },
    {
      "identifier": "IODevice",
      "ref": "IODEVICE01"
    }
  ]
}